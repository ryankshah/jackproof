#!/bin/sh
message_file="$1"
lowered=$(LC_ALL=C tr '[:upper:]' '[:lower:]' < "$message_file")

for pattern in 'co-authored-by' 'generated with'; do
	if printf '%s\n' "$lowered" | LC_ALL=C grep -qF -e "$pattern"; then
		echo "commit-msg: message contains forbidden text: $pattern" >&2
		exit 1
	fi
done
